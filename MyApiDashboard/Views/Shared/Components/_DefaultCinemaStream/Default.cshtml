@using MyApiDashboard.Dtos
@model CinemaDto
@*
    Cinema Stream
*@
<section class="col-md-6">
    <div class="win-window">

        <div class="win-title-bar">
            <span>CINEMA_STREAM.AVI</span>
            <span>[x]</span>
        </div>

        <div class="win-body p-0 d-flex flex-column align-items-center justify-content-center"
             style="background:#000; min-height: 250px; overflow: hidden;">

            <div>
                <strong style="color: #ffff00;">[OVERVIEW]:</strong>
                <p id="movieDescription" style="font-size: 0.85rem; line-height: 1.4;">
                    @Model.Description
                </p>
            </div>
            <div class="mt-auto mb-2 w-100 text-center"
                 style="background: rgba(0,0,0,0.7);">

                <span id="movieTitle"
                      style="color:#ffff00; font-size:0.9rem; font-weight:bold;">
                    @Model.Title
                </span>

            </div>

        </div>

        <!-- REFRESH BUTTON -->
        <div class="refresh-wrapper">
            <button class="win-refresh-btn" onclick="refreshMovie()">
                Refresh
            </button>
        </div>

    </div>
</section>
<script>
    function refreshMovie() {
        fetch('/Cinema/GetRandomMovieComponent') // Controller metodun hangisiyse o URL
            .then(response => response.json()) // Metin değil JSON bekliyoruz
            .then(data => {
                // Service içinde ismini değiştirdiğimiz için data.description kullanıyoruz
                document.getElementById("movieTitle").innerText = data.title;
                document.getElementById("movieDescription").innerText = data.description;
            })
            .catch(err => console.log("Hata:", err));
    }
</script>