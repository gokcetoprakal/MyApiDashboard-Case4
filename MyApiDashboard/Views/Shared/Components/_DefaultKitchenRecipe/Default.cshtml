@using MyApiDashboard.Dtos
@model RecipeDto
@*
    Kitchen OS Recipe 
*@

<section class="col-md-3" id="recipe-section">
    <div class="win-window">
        <div class="win-title-bar">
            <span>RECIPE_NOTES.TXT</span>
            <span>[x]</span>
        </div>
        <div class="win-body" style="background: #fff9c4; color: #333; padding: 15px; min-height: 180px; box-shadow: inset 0 0 10px rgba(0,0,0,0.1);">
            @* Başlık: El yazısı fontu varsa harika durur *@
            <h6 style="border-bottom: 2px solid #ef5350; padding-bottom: 5px; font-weight: bold; color: #d32f2f;">
                📌 @Model.Title
            </h6>

            @* Açıklama: Satır sınırlaması ile kutuyu taşmasını engelliyoruz *@
            <p style="font-size: 0.8rem; font-style: italic; color: #555; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 6; -webkit-box-orient: vertical; overflow: hidden;">
                @Model.Description
            </p>
        </div>
        <div class="refresh-wrapper">
            <button class="win-refresh-btn" onclick="refreshRecipe()">Next Recipe</button>
        </div>
    </div>
</section>

<script>
    function refreshRecipe() {
        fetch('/Recipe/GetRandomRecipeComponent')
            .then(res => res.text())
            .then(html => {
                document.getElementById("recipe-section").outerHTML = html;
            })
            .catch(err => console.log("Recipe error:", err));
    }
</script>